<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>LoMSaveManager.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core is compiled into the test runner as source (Core targets net48, the runner runs on net9). -->
    <Compile Include="..\..\src\Core\**\*.cs" Exclude="..\..\src\Core\bin\**;..\..\src\Core\obj\**" LinkBase="Core" />
  </ItemGroup>
</Project>
